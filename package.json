{
  "name": "tui-hermes-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=apps/server/.env.local run --filter server --filter console --elide-lines=0 dev",
    "dev:server": "bun --env-file=apps/server/.env.local run --filter server dev",
    "dev:console": "bun run --filter console dev",
    "build": "bun run --filter console build",
    "start": "bun --env-file=apps/server/.env.local run --filter server start",
    "lint": "bun run --filter console lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:generate": "bun --env-file=apps/server/.env.local run --filter server db:generate",
    "db:migrate": "bun --env-file=apps/server/.env.local run --filter server db:migrate"
  }
}
