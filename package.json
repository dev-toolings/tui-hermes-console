{
  "name": "tui-hermes-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=apps/server/.env.local run --filter server --filter web dev",
    "dev:server": "bun --env-file=apps/server/.env.local run --filter server dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --filter web build",
    "start": "bun --env-file=apps/server/.env.local run --filter server start",
    "lint": "bun run --filter web lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:generate": "bun --env-file=apps/server/.env.local run --filter server db:generate",
    "db:migrate": "bun --env-file=apps/server/.env.local run --filter server db:migrate",
    "proof:g1-001": "bun apps/server/scripts/prove-artifact-durability.ts",
    "proof:g1-002": "bun apps/server/scripts/prove-hermes-confinement.ts",
    "proof:g1-002a": "bun apps/server/scripts/prove-hermes-confinement.ts",
    "proof:g1-002b": "bun apps/server/scripts/prove-hermes-confinement-real.ts",
    "proof:g1-002c": "bun apps/server/scripts/prove-hermes-candidate-matrix.ts",
    "proof:g1-004": "bun apps/server/scripts/prove-g1-004-local.ts",
    "proof:g1-004-real": "bun apps/server/scripts/prove-g1-004-local-real.ts",
    "proof:g1-004a": "bun apps/server/scripts/prove-g1-004-local.ts",
    "proof:g1-004b": "bun test apps/server/src/modules/runs/respond-approval.test.ts apps/server/drizzle/site-context-api.integration.test.ts --max-concurrency=1",
    "proof:g1-004c": "bun test packages/console-core/src/lib/hermes-events-approval.test.ts packages/console-core/src/lib/thread-snapshot-mutations.test.ts apps/server/src/modules/runs/approval-requests.test.ts apps/server/src/modules/runs/respond-approval.test.ts apps/server/drizzle/approval-requests.test.ts apps/server/drizzle/approval-requests.integration.test.ts --max-concurrency=1",
    "policy:keygen": "bun apps/server/scripts/generate-hermes-policy-key.ts",
    "proof:g1-005b": "bun apps/server/scripts/prove-g1-005b-local.ts",
    "proof:g1-005c": "bun test apps/server/src/db/production-migration.test.ts --max-concurrency=1",
    "proof:g1-006-dr": "bun apps/server/scripts/prove-lifecycle-dr-local.ts",
    "proof:g1-006e": "bun test apps/server/src/modules/retention/purge.test.ts apps/server/drizzle/lifecycle-purge.integration.test.ts --max-concurrency=1",
    "proof:g1-003": "bun test apps/server/drizzle/ai-disclosure-consent.integration.test.ts",
    "proof:g1-007a": "bun apps/server/scripts/prove-g1-007a-local.ts",
    "runtime:probe": "bun apps/server/scripts/probe-runtime.ts",
    "prepare:e2e:g1-003": "bun apps/server/scripts/prepare-ai-disclosure-e2e.ts"
  }
}
