# Copy to .env.local (`make env`), then fill in the Hermes runtime values.

# Postgres dédié — conteneur `infra-postgres` (~/Documents/infra/compose.yml)
DATABASE_URL=postgres://test:test@localhost:5432/hermes_console

# Chiffrement du token runtime — 64 chars hex, 32 bytes base64, ou passphrase.
# `make env` en génère une automatiquement via `openssl rand -hex 32`.
APP_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

# Runtime Hermes — fallback accès direct uniquement, si aucune config n'est
# stockée en base (la config DB est prioritaire). Le mode tunnel SSH se
# configure exclusivement dans Paramètres → Runtime.
# API server, PAS le dashboard (:9119).
HERMES_BASE_URL=http://localhost:8642
HERMES_RUNTIME_TOKEN=
# `agent` (défaut, /v1/runs) ou `responses` (/v1/responses)
HERMES_PROTOCOL=agent

# Volume partagé avec l'hôte Hermes — même chemin des deux côtés.
HERMES_SHARED_WORKDIR=/tmp/hermes-console-work

# Limites fichiers — défauts dans src/modules/settings/storage-stats.ts
# MAX_FILE_SIZE_BYTES=20971520
# MAX_RUN_FILES_TOTAL_BYTES=104857600
# MAX_RUN_FILE_COUNT=20
