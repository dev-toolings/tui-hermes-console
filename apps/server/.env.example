# Copy to .env.local (`make env`), then fill in the Hermes runtime values.

# Postgres dédié — conteneur `infra-postgres` (~/Documents/infra/compose.yml)
DATABASE_URL=postgres://test:test@localhost:5432/hermes_console

# Chiffrement du token runtime — 64 chars hex, 32 bytes base64, ou passphrase.
# `make env` en génère une automatiquement via `openssl rand -hex 32`.
APP_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

# Runtime Hermes — fallback accès direct uniquement, si aucune config n'est
# stockée en base (la config DB est prioritaire). Le mode tunnel SSH se
# configure exclusivement dans Paramètres → Runtime.
# API server, PAS le dashboard (:9119).
HERMES_BASE_URL=http://localhost:8642
HERMES_RUNTIME_TOKEN=
# `agent` (défaut, /v1/runs) ou `responses` (/v1/responses)
HERMES_PROTOCOL=agent
# Chemin absolu optionnel pour les services dont le PATH n'inclut pas la CLI.
# HERMES_CLI_PATH=/home/user/.local/bin/hermes

# Volume partagé avec l'hôte Hermes — même chemin des deux côtés.
HERMES_SHARED_WORKDIR=/tmp/hermes-console-work

# Authentification Google OIDC (Web application). `GOOGLE_REDIRECT_URI` doit être
# exactement l'URI déclarée dans Google Cloud, par exemple
# http://127.0.0.1:3170/api/auth?action=callback en développement.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3170/api/auth?action=callback
# Liste séparée par des virgules des comptes Console autorisés. Obligatoire.
GOOGLE_ALLOWED_EMAILS=admin@example.com
# Autorité d'installation séparée des rôles de site. Recommandée dès qu'il y a
# plusieurs comptes ; avec une seule identité Google, celle-ci sert de fallback.
INSTALLATION_ADMIN_EMAILS=admin@example.com
# Origine publique du SPA après le callback (aucune valeur déduite de Host).
CONSOLE_APP_ORIGIN=http://127.0.0.1:1420
# Bind explicite du serveur Bun : conserver loopback en local; configurer le nom/IP public derrière un proxy.
CONSOLE_SERVER_HOST=127.0.0.1
# Activer uniquement derrière Caddy, qui réécrit X-Forwarded-For depuis le pair TCP.
CONSOLE_TRUST_PROXY=0

# Limites fichiers — défauts dans src/modules/settings/storage-stats.ts
# MAX_FILE_SIZE_BYTES=20971520
# MAX_RUN_FILES_TOTAL_BYTES=104857600
# MAX_RUN_FILE_COUNT=20
