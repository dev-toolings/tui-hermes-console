{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "sidecar:build": "bun build --compile --target=bun-darwin-arm64 --external cpu-features ../server/src/index.ts --outfile src-tauri/binaries/hermes-server-aarch64-apple-darwin",
    "tauri:dev": "bun run sidecar:build && cargo tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "bun run sidecar:build && cargo tauri build --config src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.1",
    "@assistant-ui/react-markdown": "^0.14.8",
    "@boardui/ui": "workspace:*",
    "@console/core": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-table": "^8.21.3",
    "docx-preview": "^0.4.0",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.7"
  }
