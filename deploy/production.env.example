# Copy to deploy/production.env. Never commit the generated file. Compose reads
# interpolation values only when invoked with:
# docker compose --env-file deploy/production.env -f compose.prod.yml up -d --build

# Caddy: use http://localhost for a local smoke test, or a public hostname for
# automatic HTTPS (for example console.example.com).
CONSOLE_SITE_ADDRESS=http://localhost

# PostgreSQL. `hermes` remains the owner for existing-volume upgrades. Only the
# one-shot migration service receives its URL and password. Keep passwords
# URL-safe because the connection URLs embed them.
POSTGRES_USER=hermes
POSTGRES_PASSWORD=replace-with-a-long-owner-url-safe-password
POSTGRES_DB=hermes_console
DATABASE_OWNER_URL=postgres://hermes:replace-with-a-long-owner-url-safe-password@postgres:5432/hermes_console
POSTGRES_RUNTIME_USER=hermes_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-a-distinct-long-runtime-url-safe-password
DATABASE_URL=postgres://hermes_runtime:replace-with-a-distinct-long-runtime-url-safe-password@postgres:5432/hermes_console

# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-64-hex-characters

# Public browser origin used for same-origin and OAuth redirects.
CONSOLE_APP_ORIGIN=http://localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth?action=callback
GOOGLE_ALLOWED_EMAILS=admin@example.com

# Optional direct-runtime fallback. Prefer configuring the remote Hermes
# installation from the Console after first login.
HERMES_BASE_URL=
HERMES_RUNTIME_TOKEN=
HERMES_PROTOCOL=agent
HERMES_SHARED_WORKDIR=/data/work

# Optional SSH overlay for the external Hermes transport. Keep this directory
# outside the repo; it must contain only the verified known_hosts and the
# deterministic SSH config/identity needed by the bun service user.
# CONSOLE_SSH_DIR=/secure/hermes-console-ssh
