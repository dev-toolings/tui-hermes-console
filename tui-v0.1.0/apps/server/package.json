{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "bun scripts/migrate-production.ts"
  },
  "dependencies": {
    "@console/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.4",
    "postgres": "^3.4.9",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/ssh2": "^1.15.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
